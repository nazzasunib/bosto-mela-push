# Copy this file to .env.local and fill in the values.
# These are read ONLY on the server — they are never sent to the browser.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string (32+ characters). Used to sign login sessions.
SESSION_SECRET=change-me-to-a-long-random-string-0123456789

# Optional: set to true only if you open the app over plain http from other devices on your LAN
# (e.g. http://192.168.0.10:3000 on a tablet) in production mode.
INSECURE_COOKIES=false
